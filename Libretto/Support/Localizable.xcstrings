    "PageSetup.Section.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the section the cursor is in. Columns are saved for Word; Libretto lays the text out in one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルのあるセクションに適用されます。段組みはWord用に保存されます。Librettoでは1段で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서가 있는 구역에 적용됩니다. 단은 Word용으로 저장되며 Libretto에서는 한 단으로 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于光标所在的节。分栏会为 Word 存储；Libretto 以单栏显示文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用到游標所在的節。欄會為 Word 儲存；Libretto 以單欄顯示文字。"
          }
        }
      }
    },
