    "Table.Select.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a cell to pick it. To pick several, turn on Extend Selection and tap the opposite corner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セルをタップして選択します。複数選択するには「選択範囲を拡張」をオンにして反対側の角をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셀을 탭하여 선택합니다. 여러 셀을 선택하려면 선택 영역 확장을 켜고 반대쪽 모서리를 탭하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点单元格以选择。要选择多个，请打开“扩展选择”并轻点对角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下儲存格即可選取。若要選取多個，請開啟「延伸選取範圍」並點一下對角。"
          }
        }
      }
    },
