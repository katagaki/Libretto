    "HeaderFooter.RichContent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one has pictures or tables, which editing its text replaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このヘッダー/フッターには画像や表が含まれています。テキストを編集すると置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머리글/바닥글에는 사진이나 표가 있으며, 텍스트를 편집하면 대치됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中包含图片或表格，编辑文本会将其替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中包含圖片或表格，編輯文字會將其取代。"
          }
        }
      }
