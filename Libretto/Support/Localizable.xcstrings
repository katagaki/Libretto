    "Review.TrackChanges.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insertions are underlined and deletions struck through, in each reviewer’s colour, until they’re accepted or rejected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "挿入は下線、削除は取り消し線で、校閲者ごとの色で表示されます。承諾または元に戻すまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삽입된 내용은 밑줄로, 삭제된 내용은 취소선으로 검토자마다 다른 색으로 표시되며, 승인하거나 거부할 때까지 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入内容加下划线、删除内容加删除线，以各审阅者的颜色显示，直到接受或拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "插入的內容加底線、刪除的內容加刪除線，以各校閱者的顏色顯示，直到接受或拒絕。"
          }
        }
      }
    },
